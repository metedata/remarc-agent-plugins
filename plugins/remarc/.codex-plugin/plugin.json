{
  "name": "remarc",
  "version": "0.13.2",
  "description": "Read, address, and resolve Remarc comments from Codex.",
  "author": {
    "name": "Mete Polat",
    "email": "mete@metedata.com"
  },
  "homepage": "https://remarc.app",
  "repository": "https://github.com/metedata/remarc-agent-plugins",
  "license": "MIT",
  "keywords": [
    "remarc",
    "comments",
    "macos",
    "code-review"
  ],
  "mcpServers": {
    "remarc": {
      "command": "node",
      "args": [
        "mcp/dist/index.js",
        "--harness",
        "codex"
      ],
      "cwd": "."
    }
  },
  "interface": {
    "displayName": "Remarc",
    "shortDescription": "Address contextual Remarc comments",
    "longDescription": "Read, address, and resolve comments captured in the Remarc macOS app.",
    "developerName": "Mete Polat",
    "category": "Developer Tools",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://remarc.app",
    "defaultPrompt": [
      "List my active Remarc sessions.",
      "Show handed-off comments in the active session.",
      "Address and resolve my Remarc comments."
    ]
  }
}
